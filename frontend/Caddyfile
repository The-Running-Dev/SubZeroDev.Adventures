{
	admin off
	auto_https off
	persist_config off
}

# The existing proxy-net reverse proxy owns TLS and the public hostname.
:8080 {
	root * /srv
	encode gzip
	header X-Content-Type-Options nosniff

	@write not method GET HEAD
	@api path /api /api/*
	@build path /__build-id
	@asset file {path}
	@hashed path_regexp hashed ^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.[^/]+$
	@navigation {
		header Accept *text/html*
		expression ({header.Sec-Fetch-Mode} == "" || {header.Sec-Fetch-Mode} == "navigate") && ({header.Sec-Fetch-Dest} == "" || {header.Sec-Fetch-Dest} == "document")
		not path_regexp resource (?i)(^/(assets|campaigns|icons|fonts|images|api|sw|service-worker|manifest)(/|$)|\.[^/]+/?$)
	}

	# Explicit ordering: files and resource errors never enter navigation fallback.
	route {
		handle @write {
			header Cache-Control no-store
			respond "Method not allowed" 405
		}
		handle @api {
			header Cache-Control no-store
			respond "Not found" 404
		}
		handle @build {
			header Cache-Control no-store
			file_server
		}
		handle @asset {
			route {
				header Cache-Control no-cache
				header @hashed Cache-Control "public, max-age=31536000, immutable"
				file_server
			}
		}
		handle @navigation {
			header Cache-Control no-cache
			header Vary "Accept, Sec-Fetch-Mode, Sec-Fetch-Dest"
			rewrite * /index.html
			file_server
		}
		handle {
			header Cache-Control no-store
			respond "Not found" 404
		}
	}

	handle_errors {
		header Cache-Control no-store
		respond "{err.status_text}" {err.status_code}
	}
}
