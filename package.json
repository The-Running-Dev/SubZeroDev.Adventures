{
  "name": "subzerodev-adventures",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-engine.mjs",
    "prepare": "node scripts/setup-engine.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:browser && npm run test:build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:update": "vitest run --config vitest.browser.config.ts --update",
    "test:build": "npm run build && node scripts/verify-build.mjs",
    "typecheck": "tsc -b",
    "sync:campaigns": "node scripts/sync-campaigns.mjs"
  },
  "dependencies": {
    "@the-running-dev/game-engine": "file:./engine/src/engine",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
