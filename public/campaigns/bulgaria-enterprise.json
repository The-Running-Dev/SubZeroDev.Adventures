    "enterprise.company_route_4.ending_successful_company": "The Durable Company",
    "enterprise.company_route_4.text": "Growth is now real enough to choose: disciplined company, platform bet, or a profitable sale before scale becomes weather.",
    "enterprise.company_route_event_1.text": "The day contributes its own amendment.",
    "enterprise.company_route_event_1a.proceed": "Save the outage postmortem",
    "enterprise.company_route_event_1a.text": "The careful hire brings a client relationship stronger than the job board promised.",
    "enterprise.company_route_event_1b.proceed": "Blame the hosting provider publicly",
