    "inheritance.records_route_4.ending_family_peace": "The Table After Court",
    "inheritance.records_route_4.text": "In court, evidence and folklore finally occupy separate tables. You decide how hard a legal victory should land.",
    "inheritance.records_route_event_1.text": "The day contributes its own amendment.",
